# Smoke-only defaults. Copy to .env.smoke for local overrides.
# This file intentionally uses a local TEI embedding container instead of a paid provider.

SMOKE_CASES="core,indexing,retrieval,mcp,memory,export"

SMOKE_EMBEDDING_PORT=8080
SMOKE_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
SMOKE_EMBEDDING_API_KEY="local-smoke-key"
SMOKE_RERANKER_PORT=8081
SMOKE_RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L6-v2"

EMBEDDING_BASE_URL="http://localhost:8080/v1"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
EMBEDDING_TIMEOUT_MS=60000
EMBEDDING_API_KEY="local-smoke-key"

RERANKER_BASE_URL="http://localhost:8081"
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L6-v2"
RERANKER_TOP_N=3
RERANKER_TIMEOUT_MS=60000
RERANKER_FALLBACK_ALLOWED=true

API_URL="http://localhost:3000"
QDRANT_URL="http://localhost:6333"
POLL_SECONDS=180
POLL_INTERVAL_SECONDS=3

API_KEY_AUTH_ENABLED="false"
ADMIN_API_KEY=""
CONTEXTFORGE_API_KEY=""
