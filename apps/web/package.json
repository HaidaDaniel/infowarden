{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "InfoWarden Admin Studio shell",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "pnpm --dir ../.. exec eslint \"apps/web/src/**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "vitest run --testTimeout=20000",
    "test:e2e": "playwright test",
    "test:e2e:live": "STUDIO_E2E_LIVE=1 playwright test e2e/live-smoke.e2e.spec.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  }
}
