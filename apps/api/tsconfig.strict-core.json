    "src/ingestion/micromatch.d.ts",
    "src/retrieval/retrieval-context-packaging.ts",
    "src/retrieval/retrieval-ranking.pipeline.ts",
    "src/retrieval/retrieval-ranking.pipeline.spec.ts",
    "src/retrieval/retrieval.types.ts"
  ]
