{
  "id": "cf-static-knowledge-golden",
  "version": "2026-10-05",
  "tier": "golden",
  "description": "Sanitized static-knowledge retrieval golden set for public v0.1: persistent Markdown documentation, a managed upload book/reference archive, and an Obsidian vault. Expected labels are reviewed and never derived from retrieval output.",
  "license": "repo-owned synthetic content",
  "languages": ["en"],
  "documentsPath": "documents",
  "questionsPath": "questions.jsonl",
  "defaultTopK": 5,
  "sourceTypes": ["local_folder", "upload", "obsidian_vault"],
  "sourceClasses": ["markdown_docs", "book_reference", "obsidian_notes"],
  "metrics": ["hit@1", "hit@3", "hit@5", "mrr", "empty_result_rate", "duplicate_rate", "latency_p50", "latency_p95"],
  "documents": [
    {
      "id": "doc_ops_runbook",
      "path": "documents/docs/ops-runbook.md",
      "sourceType": "local_folder",
      "sourceClass": "markdown_docs",
      "language": "en",
      "tags": ["ops", "runbook", "on-call"]
    },
