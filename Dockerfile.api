FROM node:24.14.0-alpine AS api-build

WORKDIR /app
ENV CI=true \
  PNPM_VERSION=10.30.3 \
  COREPACK_DEFAULT_TO_LATEST=0
RUN apk add --no-cache openssl
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/mcp-server/package.json apps/mcp-server/package.json
RUN pnpm install --frozen-lockfile --filter api

COPY prisma prisma
COPY apps/api apps/api
COPY scripts/benchmarks scripts/benchmarks
RUN pnpm --filter api prisma:generate
RUN pnpm --filter api build

FROM api-build AS api-migrate

ENV NODE_ENV=production \
  NODE_PATH=/app/node_modules/.pnpm/node_modules
RUN chown -R node:node /app
USER node
CMD ["./node_modules/.bin/prisma", "migrate", "deploy", "--schema", "prisma/schema.prisma"]

FROM api-build AS api-prod

RUN pnpm prune --prod
RUN mkdir -p /prod/apps/api \
  && cp package.json pnpm-workspace.yaml /prod/ \
  && cp apps/api/package.json /prod/apps/api/package.json \
  && cp -R apps/api/dist /prod/apps/api/dist \
  && cp -R apps/api/node_modules /prod/apps/api/node_modules \
  && cp -R node_modules /prod/node_modules \
  && mkdir -p /prod/scripts \
  && cp -R scripts/benchmarks /prod/scripts/benchmarks \
  && find /prod -type f \( -name "*.map" -o -name "*.tsbuildinfo" -o -name "*.spec.*" -o -name "*.test.*" \) -delete

FROM node:24.14.0-alpine AS api-runtime

ENV NODE_ENV=production \
  NODE_PATH=/app/node_modules/.pnpm/node_modules
WORKDIR /app/apps/api
RUN apk add --no-cache openssl unzip \
  && mkdir -p /var/lib/contextforge/uploads \
  && chown -R node:node /var/lib/contextforge

COPY --from=api-prod --chown=node:node /prod /app
COPY --from=api-build --chown=node:node /app/prisma /app/prisma

USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 3000) + '/health').then((r) => { if (!r.ok) process.exit(1); }).catch(() => process.exit(1))"
CMD ["node", "dist/main.js"]
