FROM node:24.14.0-alpine AS mcp-build

WORKDIR /app
ENV CI=true \
  PNPM_VERSION=10.30.3 \
  COREPACK_DEFAULT_TO_LATEST=0
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/mcp-server/package.json apps/mcp-server/package.json
RUN pnpm install --frozen-lockfile --filter mcp-server

COPY apps/mcp-server apps/mcp-server
RUN pnpm --filter mcp-server build
RUN pnpm prune --prod
RUN mkdir -p /prod/apps/mcp-server \
  && cp package.json pnpm-workspace.yaml /prod/ \
  && cp apps/mcp-server/package.json /prod/apps/mcp-server/package.json \
  && cp -R apps/mcp-server/dist /prod/apps/mcp-server/dist \
  && cp -R apps/mcp-server/node_modules /prod/apps/mcp-server/node_modules \
  && cp -R node_modules /prod/node_modules \
  && find /prod -type f \( -name "*.map" -o -name "*.tsbuildinfo" -o -name "*.spec.*" -o -name "*.test.*" \) -delete

FROM node:24.14.0-alpine AS mcp-runtime

ENV NODE_ENV=production \
  NODE_PATH=/app/node_modules/.pnpm/node_modules
WORKDIR /app/apps/mcp-server

COPY --from=mcp-build --chown=node:node /prod /app

USER node
EXPOSE 3003
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.MCP_HTTP_PORT || 3003) + '/health').then((r) => { if (!r.ok) process.exit(1); }).catch(() => process.exit(1))"
CMD ["node", "dist/index.js", "--http"]
