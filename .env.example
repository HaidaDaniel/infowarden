# Database
# CONTEXTFORGE_* names remain stable runtime compatibility identifiers.
POSTGRES_PASSWORD="infowarden_dev_password"
DATABASE_URL="postgresql://infowarden:infowarden_dev_password@localhost:5432/infowarden?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Qdrant
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_HTTP_URL="http://localhost:6333"
QDRANT_GRPC_PORT=6334
QDRANT_HTTPS="false"

# Server
PORT=3000
NODE_ENV="development"
API_KEY_AUTH_ENABLED="false"
ADMIN_API_KEY=""
API_MAX_BODY_BYTES=1048576
INDEXING_WORKER_CONCURRENCY=1

# Studio web UI used by `pnpm dev`
DEV_AUTO_FREE_PORTS="0"
DEV_KILL_FOREIGN_PORT_PROCESSES="0"
DEV_START_WEB="1"
DEV_STUDIO_DIRECT_API="0"
WEB_HOST="127.0.0.1"
WEB_PORT=5173
VITE_API_BASE_URL=""
VITE_API_PROXY_TARGET="http://localhost:3000"
CORS_ORIGIN="*"

# MCP Server
CONTEXTFORGE_BACKEND_URL="http://localhost:3000"
CONTEXTFORGE_API_KEY=""
MCP_HTTP_HOST="0.0.0.0"
MCP_HTTP_PORT=3003
MCP_HTTP_PATH="/mcp"
MCP_AUTH_ENABLED="false"

# Local model providers used by `pnpm dev`
# Set DEV_USE_EXTERNAL_PROVIDER=1 to keep dev lightweight and use EMBEDDING_*/RERANKER_* endpoints from this file instead of local CPU TEI containers.
DEV_USE_EXTERNAL_PROVIDER="0"
DEV_START_LOCAL_EMBEDDINGS="1"
DEV_START_LOCAL_RERANKER="1"
DEV_REGISTER_LOCAL_PROVIDERS="1"
DEV_PRUNE_LOCAL_PROVIDER_CONFIGS="0"
SMOKE_EMBEDDING_PORT=8080
SMOKE_EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
SMOKE_EMBEDDING_API_KEY="local-smoke-key"
SMOKE_RERANKER_PORT=8081
SMOKE_RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L6-v2"

# Embedding Provider
EMBEDDING_BASE_URL="http://localhost:8080/v1"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
EMBEDDING_TIMEOUT_MS=60000
EMBEDDING_API_KEY="local-smoke-key"

# Reranker Provider
RERANKER_BASE_URL="http://localhost:8081"
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L6-v2"
RERANKER_TOP_N=3
RERANKER_TIMEOUT_MS=60000
RERANKER_FALLBACK_ALLOWED=true

# Provider API Keys (add as needed)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Production compose overrides
# Copy only the needed values into a private production env file or secret store.
# Do not reuse development defaults.
CONTEXTFORGE_API_PORT=3000
CONTEXTFORGE_MCP_PORT=3003
CONTEXTFORGE_STUDIO_PORT=8080
CONTEXTFORGE_API_IMAGE="infowarden/api:local"
CONTEXTFORGE_MCP_IMAGE="infowarden/mcp-server:local"
CONTEXTFORGE_STUDIO_IMAGE="infowarden/studio:local"
# Required production values to override before running docker-compose.production.yml:
# POSTGRES_PASSWORD, REDIS_PASSWORD, DATABASE_URL, ADMIN_API_KEY, CORS_ORIGIN,
# QDRANT_API_KEY, EMBEDDING_BASE_URL, EMBEDDING_MODEL, EMBEDDING_DIMENSION,
# EMBEDDING_API_KEY.
